{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "digest": {
    "enabled": false
  },
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "ignoreUnstable": true,
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security",
      "dependencies"
    ],
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "automerge": false,
      "description": "GitHub Actions - Version updates only for stable releases",
      "matchDepTypes": [
        "action"
      ]
    },
    {
      "description": "Tout ce qui monte se fusionne seul quand la CI est verte (op\u00e9rateur, 2026-10-14)",
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": true,
      "platformAutomerge": true
    }
  ],
  "respectLatest": true,
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "rollbackPrs": false
}
